<?xml version="1.0" encoding="utf-8"?>
<com.facebook.shimmer.ShimmerFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/shimmerNativeMedium"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:shimmer_auto_start="true"
    app:shimmer_base_alpha="0.6"
    app:shimmer_duration="1200"
    app:shimmer_highlight_alpha="0.9">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_native_ad_border"
        android:padding="8dp">

        <View
            android:id="@+id/shimmerMedia"
            android:layout_width="match_parent"
            android:layout_height="115dp"
            android:background="#D1D5DB"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <View
            android:id="@+id/shimmerIcon"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginTop="8dp"
            android:background="#D1D5DB"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/shimmerMedia" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="@id/shimmerIcon"
            app:layout_constraintEnd_toStartOf="@+id/shimmerCta"
            app:layout_constraintStart_toEndOf="@id/shimmerIcon"
            app:layout_constraintTop_toTopOf="@id/shimmerIcon">

            <View
                android:layout_width="100dp"
                android:layout_height="12dp"
                android:background="#D1D5DB" />

            <View
                android:layout_width="140dp"
                android:layout_height="10dp"
                android:layout_marginTop="6dp"
                android:background="#E5E7EB" />
        </LinearLayout>

        <View
            android:id="@+id/shimmerCta"
            android:layout_width="95dp"
            android:layout_height="36dp"
            android:background="#CBD5E1"
            app:layout_constraintBottom_toBottomOf="@id/shimmerIcon"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/shimmerIcon" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.facebook.shimmer.ShimmerFrameLayout>
