<?xml version="1.0" encoding="utf-8"?>
<com.facebook.shimmer.ShimmerFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/shimmerNativeLarge"
    android:layout_width="match_parent"
    android:layout_height="260dp"
    app:shimmer_auto_start="true"
    app:shimmer_base_alpha="0.6"
    app:shimmer_duration="1200"
    app:shimmer_highlight_alpha="0.9">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_native_ad_border"
        android:padding="8dp">

        <!-- Shimmer App Icon -->
        <View
            android:id="@+id/shimmerIcon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="#D1D5DB"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Shimmer Texts -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="@id/shimmerIcon"
            app:layout_constraintEnd_toStartOf="@+id/shimmerCta"
            app:layout_constraintStart_toEndOf="@id/shimmerIcon"
            app:layout_constraintTop_toTopOf="@id/shimmerIcon">

            <View
                android:layout_width="120dp"
                android:layout_height="14dp"
                android:background="#D1D5DB" />

            <View
                android:layout_width="160dp"
                android:layout_height="10dp"
                android:layout_marginTop="6dp"
                android:background="#E5E7EB" />
        </LinearLayout>

        <!-- Shimmer CTA Button -->
        <View
            android:id="@+id/shimmerCta"
            android:layout_width="90dp"
            android:layout_height="36dp"
            android:background="#CBD5E1"
            app:layout_constraintBottom_toBottomOf="@id/shimmerIcon"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/shimmerIcon" />

        <!-- Bottom full width description -->
        <View
            android:id="@+id/shimmerBottomDesc"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:background="#D1D5DB"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Shimmer Media Banner - centered between the icon/CTA row above
             and the bottom description row below -->
        <View
            android:id="@+id/shimmerMedia"
            android:layout_width="match_parent"
            android:layout_height="130dp"
            android:background="#D1D5DB"
            app:layout_constraintBottom_toTopOf="@id/shimmerBottomDesc"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/shimmerIcon"
            app:layout_constraintVertical_bias="0.5" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.facebook.shimmer.ShimmerFrameLayout>